# Base URL of the backend API (scheme + host, no /api/v1). Leave empty to call the same origin;
# in `npm run dev` Vite then proxies /api to DEV_API_PROXY_TARGET.
VITE_API_BASE_URL=
DEV_API_PROXY_TARGET=http://localhost:8080

# Public contact channels. Leave blank until confirmed; never put secrets here.
VITE_PARTNERSHIP_EMAIL=
VITE_PARTNERSHIP_PHONE=

# Kiosk screen (/buy). Machine-bound key issued once by an ADMIN (Máy bán hàng → Khóa API kiosk).
# Set it only in the kiosk machine's untracked .env.local — never commit it. It is sent as X-Kiosk-Key.
VITE_KIOSK_API_KEY=
# Seconds without touch on the payment screen before the order is cancelled automatically.
VITE_KIOSK_PAYMENT_IDLE_SECONDS=120
# "Báo sự cố" corner button and QR (FE 5.4, on by default since FE 8.3). Set false to hide it on a machine.
# The QR's URL comes from the backend (GET /kiosk/incident-report-link, PUBLIC_REPORT_BASE_URL + the machine's token).
VITE_KIOSK_INCIDENT_REPORT=true
# Dev only (`npm run dev` against a local backend with PAYMENT_PROVIDER=MOCK): the backend's MOCK webhook secret, so the
# kiosk can show "Giả lập thanh toán thành công (Mock Pay)". Put it in the untracked .env.local, never commit it.
# Leave empty to hide the button. Never read in a production build (import.meta.env.DEV is false there).
VITE_DEV_MOCK_WEBHOOK_SECRET=
