# Base URL of the backend API (scheme + host, no /api/v1). Leave empty to call the same origin;
# in `npm run dev` Vite then proxies /api to DEV_API_PROXY_TARGET.
VITE_API_BASE_URL=
DEV_API_PROXY_TARGET=http://localhost:8080

# Public contact channels. Leave blank until confirmed; never put secrets here.
VITE_PARTNERSHIP_EMAIL=
VITE_PARTNERSHIP_PHONE=

# Kiosk screen (/buy). Machine-bound key issued once by an ADMIN (Máy bán hàng → Khóa API kiosk).
# Set it only in the kiosk machine's untracked .env.local — never commit it. It is sent as X-Kiosk-Key.
VITE_KIOSK_API_KEY=
# Seconds without touch on the payment screen before the order is cancelled automatically.
VITE_KIOSK_PAYMENT_IDLE_SECONDS=120
