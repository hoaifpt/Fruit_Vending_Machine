# Copy to .env in the repository root; use docker compose --env-file .env.
# These settings are for the local PostgreSQL container.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=fruit_machine
DB_USER=fruit_machine
DB_PASSWORD=replace_with_your_local_password
SERVER_PORT=8080
# Base64-encoded cryptographically random key, minimum 32 decoded bytes for HS256.
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
# Local development only; disabled in the prod profile.
API_DOCS_ENABLED=true
# Required only when the database has no ADMIN; use your ignored .env, never Git.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=
# Reusable account creation policy; allowed 8-72, default 12 characters; BCrypt max 72 UTF-8 bytes.
PASSWORD_MIN_LENGTH=12
# Order reservation (ISO-8601 durations). Defaults shown; sweep releases expired PENDING_PAYMENT orders.
ORDER_RESERVATION_TTL=PT5M
ORDER_MAX_TOTAL_QUANTITY=5
ORDER_EXPIRY_SWEEP_ENABLED=true
ORDER_EXPIRY_SWEEP_INTERVAL=PT30S
ORDER_EXPIRY_SWEEP_BATCH_SIZE=50
# Payment attempts. MOCK is for local development/tests only and is rejected by the prod profile.
PAYMENT_PROVIDER=MOCK
PAYMENT_ATTEMPT_TTL=PT5M
PAYMENT_MIN_REMAINING_HOLD=PT30S
PAYMENT_MAX_ATTEMPTS_PER_ORDER=5
PAYMENT_PROVIDER_TIMEOUT=PT10S
