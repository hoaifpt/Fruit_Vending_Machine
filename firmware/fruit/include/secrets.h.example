#pragma once

// Copy to secrets.h (ignored by Git). Leave Wi-Fi/MQTT empty to run Serial-only (servo test, dispense over USB).

#define APP_WIFI_SSID "YOUR_WIFI_NAME"
#define APP_WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// IP of the computer running the Mosquitto broker (backend repo: infra/mosquitto).
#define APP_MQTT_HOST "192.168.1.100"
#define APP_MQTT_PORT 1883

// Machine code created in the backend; also the broker username. Password = this machine's broker password.
#define APP_MACHINE_CODE "FV-DEV-001"
#define APP_MQTT_PASSWORD "YOUR_MACHINE_MQTT_PASSWORD"
